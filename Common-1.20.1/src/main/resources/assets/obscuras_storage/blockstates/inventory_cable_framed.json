{
    "multipart": [
    	{	"apply": { "model": "obscuras_storage:block/cable_framed" } },
        {   "when": { "north": "false" },
            "apply": { "model": "obscuras_storage:block/cable_closed_framed", "uvlock": true }
        },
        {   "when": { "east": "false" },
            "apply": { "model": "obscuras_storage:block/cable_closed_framed", "y": 90, "uvlock": true }
        },
        {   "when": { "south": "false" },
            "apply": { "model": "obscuras_storage:block/cable_closed_framed", "y": 180, "uvlock": true }
        },
        {   "when": { "west": "false" },
            "apply": { "model": "obscuras_storage:block/cable_closed_framed", "y": 270, "uvlock": true }
        },
        {   "when": { "up": "false" },
            "apply": { "model": "obscuras_storage:block/cable_closed_framed", "x": -90, "uvlock": true }
        },
        {   "when": { "down": "false" },
            "apply": { "model": "obscuras_storage:block/cable_closed_framed", "x": 90, "uvlock": true }
        },
        {   "when": { "north": "true" },
            "apply": { "model": "obscuras_storage:block/cable_open_framed", "uvlock": true }
        },
        {   "when": { "east": "true" },
            "apply": { "model": "obscuras_storage:block/cable_open_framed", "y": 90, "uvlock": true }
        },
        {   "when": { "south": "true" },
            "apply": { "model": "obscuras_storage:block/cable_open_framed", "y": 180, "uvlock": true }
        },
        {   "when": { "west": "true" },
            "apply": { "model": "obscuras_storage:block/cable_open_framed", "y": 270, "uvlock": true }
        },
        {   "when": { "up": "true" },
            "apply": { "model": "obscuras_storage:block/cable_open_framed", "x": -90, "uvlock": true }
        },
        {   "when": { "down": "true" },
            "apply": { "model": "obscuras_storage:block/cable_open_framed", "x": 90, "uvlock": true }
        }
    ]
}
