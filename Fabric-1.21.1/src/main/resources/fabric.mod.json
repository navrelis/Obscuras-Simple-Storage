{
  "schemaVersion": 1,
  "id": "obscuras_storage",
  "version": "${version}",

  "name": "Obscura's Simple Storage",
  "description": "A heavily optimized storage mod for Minecraft, made and maintained by Navrelis.",
  "authors": [
    "Navrelis"
  ],
  "contact": {
  },

  "license": "MIT",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
  	"client": [
      "com.obscura.storage.StorageModClient"
    ],
    "main": [
      "com.obscura.storage.StorageMod"
    ],
    "modmenu": [
      "com.obscura.storage.ModMenu"
    ],
	"rei_client": [
    	"com.obscura.storage.rei.REIPlugin"
    ],
    "emi": [
    	"com.obscura.storage.emi.EMIPlugin"
    ],
    "jei_mod_plugin": [
		"com.obscura.storage.jei.JEIHandler"
	],
	"cardinal-components": [
    	"com.obscura.storage.StorageModComponents"
    ],
    "jade": [
		"com.obscura.storage.jade.JadePlugin"
	]
  },
  "mixins": [
    "obscuras_storage.mixins.json"
  ],
	"accessWidener" : "obscuras_storage.accesswidener",
  "depends": {
    "fabricloader": ">=0.7.4",
    "fabric": ">=0.100.3",
    "minecraft": ">=1.21 <1.21.2"
  },
  "custom": {
        "cardinal-components": [
            "obscuras_storage:block_filter"
        ]
    }
}
